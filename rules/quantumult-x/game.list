# Steam China - Platform
HOST,csgo.wmsj.cn,direct
HOST,dota2.wmsj.cn,direct
HOST,wmsjsteam.com,direct
HOST-SUFFIX,steamchina.com,direct

# Steam China - Download CDN
HOST,dl.steam.clngaa.com,direct
HOST,dl.steam.ksyna.com,direct
HOST,st.dl.bscstorage.net,direct
HOST,st.dl.eccdnx.com,direct
HOST,st.dl.pinyuncloud.com,direct
HOST,steampipe.steamcontent.tnkjmec.com,direct
HOST,steampowered.com.8686c.com,direct
HOST,steamstatic.com.8686c.com,direct
HOST,xz.pphimalayanrt.com,direct

# Steam - 下载协商与控制通道
HOST-SUFFIX,api.steampowered.com,direct
HOST-SUFFIX,cdn.steampowered.com,direct
HOST-SUFFIX,client-download.steampowered.com,direct
HOST-SUFFIX,media.steampowered.com,direct

# Steam - Content & Download CDN
HOST-SUFFIX,cm.steampowered.com,direct
HOST-SUFFIX,steamcontent.com,direct
HOST-SUFFIX,steamcontent.net,direct
HOST-SUFFIX,steamserver.net,direct

# Steam - Static & User Content CDN
HOST-SUFFIX,steamcdn-a.akamaihd.net,direct
HOST-SUFFIX,steamstatic.com,direct
HOST-SUFFIX,steamusercontent.com,direct

# Epic Games - 平台后端 API（实测直连 240-300ms，与代理相当且更稳定）
HOST-SUFFIX,ol.epicgames.com,direct
HOST-SUFFIX,on.epicgames.com,direct
HOST-SUFFIX,epicgames.dev,direct
HOST,tracking.epicgames.com,direct

# Epic Games - 下载与内容 CDN（实测直连 1.4-2.1MB/s，代理 0.3-0.7MB/s 且偶发 TLS 失败）
HOST,download.epicgames.com,direct
HOST,launcher.epicgames.com,direct
HOST,cdn1.epicgames.com,direct
HOST,cdn2.epicgames.com,direct
HOST,cdn1.unrealengine.com,direct
HOST,cdn2.unrealengine.com,direct
HOST,epicgames-download1.akamaized.net,direct
HOST-SUFFIX,epicgamescdn.com,direct
HOST-REGEX,^epicgames-download\d+-\d+\.file\.myqcloud\.com$,direct
HOST-REGEX,^cdn\d+-epicgames-\d+\.file\.myqcloud\.com$,direct

# Epic Games - 网页与静态资源（实测直连中位数不劣于代理）
HOST,epicgames.com,direct
HOST,www.epicgames.com,direct
HOST,static-assets-prod.epicgames.com,direct
HOST,dev.epicgames.com,direct

# Epic Games - Anti-Cheat
HOST-SUFFIX,eac-cdn.com,direct
HOST-SUFFIX,easy.ac,direct
HOST-SUFFIX,easyanticheat.net,direct

# Epic Games - 帮助站点

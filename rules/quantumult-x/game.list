# NAME: Game
# SOURCE: https://raw.githubusercontent.com/gwyntoria/network_config_set/refs/heads/main/rules/quantumult-x/game.list
# UPDATED: 2026-11-26

# Steam China - Platform
HOST-SUFFIX,steamchina.com,direct

# Steam China - Download CDN（实测直连 17-26ms，代理 86-783ms）
HOST,dl.steam.clngaa.com,direct
HOST,st.dl.bscstorage.net,direct
HOST,st.dl.eccdnx.com,direct
HOST,xz.pphimalayanrt.com,direct

# Steam - 下载协商与控制通道（api 决定下发哪套内容服务器，必须直连）
HOST-SUFFIX,api.steampowered.com,direct
HOST-SUFFIX,cdn.steampowered.com,direct
HOST-SUFFIX,client-download.steampowered.com,direct
HOST-SUFFIX,media.steampowered.com,direct

# Steam - 内容 CDN（国内内容服务器）
HOST-SUFFIX,cm.steampowered.com,direct
HOST-SUFFIX,steamcontent.com,direct
HOST-SUFFIX,steamserver.net,direct

# Steam - 客户端更新（批量；其余 steamstatic 资源见 proxy 段）
HOST,cdn.steamstatic.com,direct
HOST,client-update.steamstatic.com,direct
HOST,client-update.akamai.steamstatic.com,direct
HOST,client-update.fastly.steamstatic.com,direct

# Steam - 用户内容 CDN
HOST-SUFFIX,steamusercontent.com,direct

# Steam - 第三方状态站（实测直连 617ms，代理 667-3609ms）
HOST,steamstat.us,direct

# Epic Games - 平台后端 API（实测直连 240-300ms，与代理相当且更稳定）
HOST-SUFFIX,ol.epicgames.com,direct
HOST-SUFFIX,epicgames.dev,direct
HOST,tracking.epicgames.com,direct

# Epic Games - 国内内容 CDN（腾讯云；直连远优于代理）
HOST-WILDCARD,epicgames-download*.file.myqcloud.com,direct
HOST-WILDCARD,cdn*-epicgames-*.file.myqcloud.com,direct

# Epic Games - 网页与静态资源（实测直连中位数不劣于代理）
HOST,epicgames.com,direct
HOST,www.epicgames.com,direct
HOST,static-assets-prod.epicgames.com,direct
HOST,dev.epicgames.com,direct

# Epic Games - Anti-Cheat
HOST-SUFFIX,eac-cdn.com,direct
HOST-SUFFIX,easy.ac,direct
HOST-SUFFIX,easyanticheat.net,direct

# Epic Games - 帮助站点
HOST-SUFFIX,helpshift.com,direct

# Epic Games - Titles
HOST-SUFFIX,battlebreakers.com,direct
HOST-SUFFIX,fortnite.com,direct
HOST-SUFFIX,paragon.com,direct
HOST-SUFFIX,playparagon.com,direct
HOST-SUFFIX,roborecall.com,direct
HOST-SUFFIX,shadowcomplex.com,direct
HOST-SUFFIX,spyjinx.com,direct

# Ubisoft - Download CDN
HOST,uplaypc-s-ubisoft.cdn.ubi.com,direct

# PlayStation - Download CDN
HOST-SUFFIX,dl.playstation.net,direct

# Steam - Store & Web
HOST-SUFFIX,s.team,proxy
HOST-SUFFIX,steamdeck.com,proxy
HOST-SUFFIX,steamgames.com,proxy
HOST-SUFFIX,steampowered.com,proxy

# Steam - Community & Chat
HOST-SUFFIX,steam-chat.com,proxy
HOST-SUFFIX,steamcommunity-a.akamaihd.net,proxy
HOST-SUFFIX,steamcommunity.com,proxy

# Steam - API & Streaming
HOST-SUFFIX,steam-api.com,proxy
HOST-SUFFIX,steam.tv,proxy

# Steam - 商店静态资源（实测代理 47-53ms，直连 171-208ms）
HOST-SUFFIX,steamstatic.com,proxy
HOST-SUFFIX,steamcdn-a.akamaihd.net,proxy

# Steam - 海外内容 CDN（实测代理 49-95ms，直连 207-248ms）
HOST-SUFFIX,steampipe.akamaized.net,proxy
HOST,st.dl.pinyuncloud.com,proxy
HOST-SUFFIX,steamcontent.net,proxy

# Valve - Web
HOST-SUFFIX,valvesoftware.com,proxy

# Epic Games - 分发与内容 CDN（CloudFront 承载；直连时解析到的边缘节点在国内
# TLS 握手不可用，启动器更新失败、官网下载只有几十 KB/s，改走代理由节点就近选路）
HOST-SUFFIX,on.epicgames.com,proxy
HOST,download.epicgames.com,proxy
HOST,launcher.epicgames.com,proxy
HOST,cdn1.epicgames.com,proxy
HOST,cdn2.epicgames.com,proxy
HOST,cdn1.unrealengine.com,proxy
HOST,cdn2.unrealengine.com,proxy
HOST,epicgames-download1.akamaized.net,proxy
HOST-SUFFIX,epicgamescdn.com,proxy

# Epic Games - 商店与账号页面（Cloudflare；实测代理 235-292ms，直连 838-891ms）
HOST-SUFFIX,store.epicgames.com,proxy
HOST-SUFFIX,accounts.epicgames.com,proxy

# Epic Games - 分发与旧 CDN（实测直连失败或低于 100KB/s）
HOST,egdownload.fastly-edge.com,proxy
HOST,epicgames.global.ssl.fastly.net,proxy

# Epic Games - 社区与资产站（实测代理 49-61ms，直连 185-304ms）
HOST-SUFFIX,artstation.com,proxy
HOST-SUFFIX,fab.com,proxy
HOST-SUFFIX,sketchfab.com,proxy

# Epic Games - 其余 epicgames.com 域名兜底；直连清单更靠前优先命中
HOST-SUFFIX,epicgames.com,proxy

# Unreal Engine
HOST-SUFFIX,unrealengine.com,proxy
HOST-SUFFIX,unrealtournament.com,proxy

# Ubisoft - Account & Store
HOST-SUFFIX,ubi.com,proxy
HOST-SUFFIX,ubisoft.com,proxy

# Ubisoft - Connect
HOST-SUFFIX,ubisoftconnect.com,proxy
HOST-SUFFIX,uplay.com,proxy

# PlayStation - Store & Web
HOST-SUFFIX,playstation.com,proxy

# PlayStation - Network & Account
HOST-SUFFIX,playstation.net,proxy
HOST-SUFFIX,playstationnetwork.com,proxy
HOST-SUFFIX,sonyentertainmentnetwork.com,proxy
